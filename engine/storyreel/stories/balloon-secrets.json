 "sets": {"day": {"type": "campus", "time": "day"}, "dusk": {"type": "campus", "time": "sunset"}, "night": {"type": "campus", "time": "night"}, "room": {"type": "bedroom", "time": "sunset"}},
 "shots": [
  {"say": "In this college,", "set": "day", "cam": {"shot": "wide", "on": [0, 2.6, -3], "move": "push", "speed": 0.16}, "crowd": {"n": 12, "area": [-5, -4, 5, 3], "anim": "idle", "balloon": 1, "seed": 2}},
  {"say": "every *secret* you keep becomes a *balloon*", "set": "day", "cam": {"shot": "close", "on": "me", "az": 18, "el": -6}, "actors": [{"id": "me", "at": [0, 0], "face": 10, "anim": "float", "expr": "neutral", "balloon": 1}]},
  {"say": "tied to your wrist.", "set": "day", "cam": {"shot": "medium", "on": "me", "az": -35, "el": -16, "rise": 1.2}, "actors": [{"id": "me", "at": [0, 0], "face": 10, "anim": "float", "expr": "happy", "balloon": 1}]},
  {"say": "You see, small secrets make small balloons.", "set": "day", "cam": {"shot": "full", "on": [0, 1.5, 0], "move": "truck", "amt": 2.4, "az": 12}, "crowd": {"n": 6, "area": [-4, -0.4, 4, 0.4], "anim": "talk", "expr": "happy", "balloon": 0.5, "seed": 8, "face": 0}},
  {"say": "But *big* ones?", "set": "day", "cam": {"shot": "close", "on": "kabir", "el": -14, "az": -14, "speed": 0.2}, "actors": [{"id": "kabir", "at": [0, 0], "anim": "shock", "expr": "shock", "balloon": 3.2}]},
  {"say": "They lift you right off the ground.", "set": "day", "cam": {"shot": "full", "on": "kabir", "az": 24, "el": -8, "move": "pull"}, "actors": [{"id": "kabir", "at": [0, 0, 0], "to": [0, 2.1, 0], "face": 0, "anim": "float", "expr": "shock", "balloon": 3.2}], "crowd": {"n": 5, "area": [-4, -3, 4, -1.5], "anim": "shock", "expr": "shock", "balloon": 0.6, "seed": 3, "face": 0}},
  {"say": "So everyone here confesses fast.", "set": "day", "cam": {"shot": "high", "on": [0, 1, -0.5], "move": "orbit", "deg": 26}, "crowd": {"n": 14, "area": [-4.5, -3, 4.5, 2], "anim": "yell", "expr": "yell", "balloon": 1, "seed": 14, "pop": 0.25, "popSpread": 0.9, "after": "cheer"}},
  {"say": "Except my roommate, Kabir.", "set": "room", "cam": {"shot": "full", "on": "kabir", "az": 38, "el": 8, "dist": 5.2}, "actors": [{"id": "kabir", "at": [-1.5, 0.62, 0.1], "face": 50, "anim": "sit", "expr": "sad", "balloon": 2.0}, {"id": "me", "at": [1.2, 0, 0.9], "face": -60, "anim": "talk", "expr": "neutral"}]},
  {"say": "Kabir had the *biggest* balloon on campus.", "set": "day", "cam": {"shot": "low", "on": "kabir", "az": -20, "move": "pull", "dist": 6}, "actors": [{"id": "kabir", "at": [0, 0.5, 0], "anim": "float", "expr": "sad", "balloon": 4.2}], "crowd": {"n": 8, "area": [-5, -3.5, 5, -1.2], "anim": "shock", "expr": "shock", "balloon": 0.6, "seed": 21, "face": 0}},
  {"say": "Every morning it dragged him a little higher.", "set": "day", "cam": {"shot": "full", "on": "kabir", "az": 30, "el": -4, "move": "crane", "deg": -16}, "actors": [{"id": "kabir", "at": [-1, 0.6, -1], "to": [-1, 2.6, -1], "face": 20, "anim": "float", "expr": "shock", "balloon": 4.2}]},
  {"say": "He held onto benches.", "set": "day", "cam": {"shot": "full", "on": "kabir", "az": 40, "el": 6, "dist": 5.2}, "actors": [{"id": "kabir", "at": [-3.4, 0.75, -1.25], "face": 180, "anim": "cling", "expr": "shock", "balloon": 4.2}]},
  {"say": "Lamp posts.", "set": "day", "cam": {"shot": "full", "on": "kabir", "az": -35, "el": -6, "dist": 5.5}, "actors": [{"id": "kabir", "at": [-2.2, 1.9, 3.1], "face": 180, "anim": "cling", "expr": "cry", "balloon": 4.2}]},
  {"say": "*Me.*", "set": "day", "cam": {"shot": "close", "on": "me", "az": 14, "el": -4, "speed": 0.25}, "fx": ["shake"], "actors": [{"id": "me", "at": [0, 0], "face": 8, "anim": "shock", "expr": "shock"}, {"id": "kabir", "at": [0.25, 1.15, -0.75], "face": 0, "anim": "cling", "expr": "cry", "balloon": 4.2}]},
  {"say": "Then one night, the wind came.", "set": "night", "cam": {"shot": "wide", "on": [0, 3.4, -3], "move": "truck", "amt": 4, "az": -18, "roll": 5, "dist": 13}, "fx": ["flash"], "crowd": {"n": 7, "area": [-5, -5, 5, -1], "anim": "cling", "expr": "shock", "balloon": 1, "seed": 31, "lift": [0.3, 0.9]}},
  {"say": "And Kabir floated past the library roof.", "set": "night", "cam": {"shot": "full", "on": "kabir", "az": 16, "el": -30, "move": "pull", "dist": 9}, "actors": [{"id": "kabir", "at": [-1.5, 5.5, -6], "to": [1.5, 10.5, -7], "face": 10, "anim": "float", "expr": "cry", "balloon": 4.4, "ease": "linear"}]},
  {"say": "I couldn't reach him.", "set": "night", "cam": {"shot": "high", "on": "me", "az": 10, "dist": 6.5, "el": 48}, "actors": [{"id": "me", "at": [0, 0, -4], "face": 0, "anim": "reach", "expr": "cry"}]},
  {"say": "So I grabbed the campus loudspeaker", "set": "night", "cam": {"shot": "full", "on": "me", "az": -24, "move": "truck"}, "actors": [{"id": "me", "at": [-4, 0, -3], "to": [0, 0, -0.5], "anim": "run", "expr": "angry", "balloon": 1, "ease": "linear"}]},
  {"say": "and yelled my *own* secret instead.", "set": "night", "cam": {"shot": "close", "on": "me", "az": 20, "el": -16, "speed": 0.18}, "fx": ["shake"], "actors": [{"id": "me", "at": [0, 0, -0.5], "face": 12, "anim": "yell", "expr": "yell", "balloon": 1}]},
  {"say": "I failed *maths.* *Twice.*", "set": "night", "cam": {"shot": "xclose", "on": "me", "az": -10, "el": -8, "dist": 2.3}, "actors": [{"id": "me", "at": [0, 0, -0.5], "face": -6, "anim": "yell", "expr": "yell", "balloon": 1, "pop": 0.75}]},
  {"say": "Then someone else yelled theirs.", "set": "night", "cam": {"shot": "close", "on": "riya", "az": -22, "el": -12}, "actors": [{"id": "riya", "at": [6, 0, 0], "face": -30, "anim": "yell", "expr": "yell", "balloon": 1.6, "pop": 0.9}]},
  {"say": "Then the whole hostel.", "set": "night", "cam": {"shot": "high", "on": [5.5, 1.2, -1], "az": -40, "move": "orbit", "deg": 20, "dist": 12, "el": 30}, "crowd": {"n": 22, "area": [1, -5, 9.5, 4], "anim": "yell", "expr": "yell", "balloon": 0.7, "seed": 44, "face": -40}},
  {"say": "And one by one, a *thousand* balloons popped.", "set": "night", "cam": {"shot": "wide", "on": [0, 3, -2], "az": 14, "el": -6, "move": "crane", "deg": 18}, "fx": ["flash"], "crowd": {"n": 34, "area": [-7, -6, 8, 3], "anim": "float", "expr": "yell", "balloon": 1.3, "seed": 52, "lift": [0.4, 1.2], "pop": 0.2, "popSpread": 1.6, "after": "cheer"}},
  {"say": "Kabir landed right in the fountain.", "set": "night", "cam": {"shot": "full", "on": [5.2, 1.5, 2.0], "az": -24, "el": 8, "move": "push", "speed": 0.14}, "actors": [{"id": "kabir", "at": [5.5, 9, 2.2], "to": [5.5, 0.6, 2.2], "face": -20, "anim": "fall", "expr": "shock", "ease": "in", "moveFor": 0.45, "then": "splash", "exprThen": "shock"}], "fx": []},
  {"say": "He still hasn't told me his secret.", "set": "dusk", "cam": {"shot": "medium", "on": "kabir", "az": -12, "el": 10, "dist": 5}, "actors": [{"id": "kabir", "at": [5.5, 0.6, 2.2], "face": -12, "anim": "splash", "expr": "smirk", "balloon": 1.2}, {"id": "me", "at": [2.6, 0, 3.0], "face": 150, "anim": "talk", "expr": "happy"}]},
  {"say": "But now, he only floats a little.", "set": "dusk", "cam": {"shot": "full", "on": "kabir", "az": 160, "el": 4, "move": "pull", "speed": 0.12}, "actors": [{"id": "kabir", "at": [0.6, 0.35, 2], "to": [0.6, 0.35, -2.5], "face": 180, "anim": "float", "expr": "happy", "balloon": 1.2, "ease": "linear"}, {"id": "me", "at": [-0.6, 0, 2], "to": [-0.6, 0, -2.5], "anim": "walk", "expr": "happy", "ease": "linear"}]}
 ]
